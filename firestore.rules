    // SuperAdmins
    match /superAdmins/{docId}{
      allow read, write: if hasAuth() && isSuperAdmin(request.auth.uid);
    }
    
    
    // Common functions

    // function isDormitoryAdmin(dormitoryId){
    //   return request.auth.uid in 
    //     get(/databases/$(database)/documents/dormitoriesPrivate/$(dormitoryId)).data.adminIds;
    // }

    // function ispageAdmin(institutionDomain){
    //   return request.auth.uid in 
    //     get(/databases/$(database)/documents/pagesPrivate/$(institutionDomain)).data.adminIds;
    // }
    
    function hasAuth(){
    	return request.auth != null;
    }
    
    function isSuperAdmin(userId){
    	return exists(/databases/$(database)/documents/superAdmins/$(userId));
    }
  }
